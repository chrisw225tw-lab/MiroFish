# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
# 可选：模型 failover 链（逗号分隔，与主模型同 base_url / 同 key）。
# 主模型遇到 5xx / 429 / 超时 / 连接错误时按顺序切换，失败模型冷却 60 秒。
# LLM_MODEL_FALLBACKS=claude-sonnet-4-6,gpt-5.4-mini

# ===== 图谱后端选择 =====
# cloud（默认）  ：Zep Cloud
# graphiti       ：本地自建 Graphiti（graphiti-core 直连 FalkorDB），见 docs/SELFHOST-GRAPHITI.md
ZEP_BACKEND=cloud

# ===== ZEP记忆图谱配置（ZEP_BACKEND=cloud 时必需）=====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 自建 Graphiti 配置（仅 ZEP_BACKEND=graphiti 时使用）=====
# FalkorDB 连接串。graphiti-mcp 的 compose 需要把 FalkorDB 端口暴露出来。
# GRAPHITI_FALKORDB_URI=redis://127.0.0.1:6380
# FalkorDB 图键，与 graphiti-mcp 的 `main` 分开，避免索引/数据互相干扰。
# GRAPHITI_FALKORDB_DATABASE=mirofish
#
# 抽取用 LLM。留空则回落到上面的 LLM_* 配置。
# GRAPHITI_LLM_API_KEY=your_api_key_here
# GRAPHITI_LLM_BASE_URL=http://127.0.0.1:8317/v1
# GRAPHITI_LLM_MODEL_NAME=Kimi-k2.6
# GRAPHITI_LLM_MODEL_FALLBACKS=claude-sonnet-4-6,gpt-5.4-mini
#
# Embedder（OpenAI 兼容，例如 Ollama）。主端点优先，失败时回落备用端点。
# 两个端点必须提供同一个模型、同一个维度，否则旧向量无法比对。
# GRAPHITI_EMBEDDER_BASE_URL=http://127.0.0.1:11434/v1
# GRAPHITI_EMBEDDER_FALLBACK_BASE_URL=
# GRAPHITI_EMBEDDER_API_KEY=ollama
# GRAPHITI_EMBEDDER_MODEL=nomic-embed-text
# GRAPHITI_EMBEDDER_DIM=768

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
